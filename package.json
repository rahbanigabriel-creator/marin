{
  "name": "marin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "22.x"
  },
  "description": "Marpin — AI marketing copilot",
  "scripts": {
    "dev": "next dev",
    "server:e2e": "node scripts/start-e2e-server.mjs",
    "build": "prisma generate && next build",
    "build:quality": "node scripts/clean-quality-build.mjs && prisma generate && NEXT_DIST_DIR=.next-quality next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "e2e": "playwright test",
    "secret:scan": "node scripts/scan-secrets.mjs",
    "test": "node scripts/run-tests.mjs unit",
    "test:db": "node scripts/run-tests.mjs integration",
    "quality": "npm run secret:scan && npm audit --omit=dev --audit-level=high && npm run lint && npm run test && npm run typecheck && npm run db:validate && npm run build:quality",
    "typecheck": "tsc --noEmit",
    "rag:demo": "node --conditions=react-server --import tsx src/lib/rag/__demo__/retrieve-demo.mts",
    "db:generate": "prisma generate",
    "db:migrate:test": "node scripts/migrate-disposable-test-db.mjs",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@clerk/nextjs": "^7.8.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.59.0",
    "@stripe/stripe-js": "^9.8.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.4.1",
    "eslint-config-next": "^15.5.19",
    "inngest": "^3.54.2",
    "langfuse": "^3.38.20",
    "next": "^15.5.19",
    "node-html-parser": "^9.0.0",
    "posthog-js": "^1.391.2",
    "posthog-node": "^5.38.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-icons": "^5.6.0",
    "resend": "^6.14.0",
    "stripe": "^22.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "postcss": "8.5.26",
    "prisma": "^6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.1",
    "typescript": "5.7.3"
  },
  "overrides": {
    "browserslist": "4.28.8",
    "deepmerge-ts": "8.0.2",
    "fflate": "0.4.9",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "pnpm": {
    "overrides": {
      "browserslist": "4.28.8",
      "deepmerge-ts": "8.0.2",
      "fflate": "0.4.9",
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    }
  }
}
